WEBCAPTIONER_BACKEND_PORT=4000
SOTRA_SERVER_CTRANSLATE_URL=http://localhost:3005
SOTRA_SERVER_FAIRSEQ_URL=http://localhost:3000
LIBRETRANSLATE_URL=http://localhost:5004
#VOSK_SERVER_URL=https://webcaptioner-spoz.mudrowak.de/
CONFIG=/app/config
BAMBORAK_SERVER=http://127.0.0.1:8080

# Database Configuration
# Option A (recommended for MongoDB Atlas): full connection string
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/test
#
# Option B: split vars (local MongoDB or Atlas)
MONGODB_USERNAME=dummy
MONGODB_PASSWORD=your-password
MONGODB_HOST=localhost:27017
MONGODB_DATABASE=agata
# For Atlas with option B, use host without port, e.g. cluster0.xxxxx.mongodb.net
# Atlas also requires your server IP in Network Access (not just your laptop IP).

# Legacy JWT (optional, für alte Tokens)
JWT_SECRET_KEY=your-jwt-secret

# Free-Login Passwort (ohne Account)
FREE_PASSWORD=your-free-password

# Lokaler Admin (wird beim ersten Start in MongoDB angelegt)
DB_ADMIN_FIRSTNAME=Admin
DB_ADMIN_LASTNAME=User
DB_ADMIN_EMAIL=admin@example.com
DB_ADMIN_PASSWORD=your-admin-password

# Keycloak (optional) – wenn alle vier Variablen gesetzt sind, wird Keycloak
# für den E-Mail-Login genutzt. Andernfalls gilt der lokale DB-Admin-User.
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=webcaptioner
# KEYCLOAK_CLIENT_ID=webcaptioner-backend
# KEYCLOAK_CLIENT_SECRET=your-backend-client-secret
# KEYCLOAK_REQUIRED_GROUP=webcaptioner

# Realm-Rolle für Admins in der App
KEYCLOAK_ADMIN_ROLE=admin
