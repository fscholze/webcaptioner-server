WEBCAPTIONER_BACKEND_PORT=4000
SOTRA_SERVER_CTRANSLATE_URL=http://localhost:3005
SOTRA_SERVER_FAIRSEQ_URL=http://localhost:3000
LIBRETRANSLATE_URL=http://localhost:5004
CONFIG=config

# Database Configuration
# Option A (recommended for MongoDB Atlas): full connection string
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/test
#
# Option B: split vars (local MongoDB or Atlas)
MONGODB_USERNAME=webcaptioner_app
MONGODB_PASSWORD=mySecretPw
MONGODB_HOST=localhost:27017
MONGODB_DATABASE=webcaptioner
JWT_SECRET_KEY=mysecretkey
FREE_PASSWORD=Test1234

DB_ADMIN_FIRSTNAME=Admin
DB_ADMIN_LASTNAME=1
DB_ADMIN_EMAIL=admin@user.de
DB_ADMIN_PASSWORD=tajne

# Keycloak (optional) – wenn alle vier Variablen gesetzt sind, läuft der
# Account-Login über das Keycloak-Anmeldefenster (Authorization Code + PKCE).
# Der Client braucht Standard Flow. Direct Access Grants werden nicht genutzt.
# Redirect-URI:  http://localhost:3000/authentication/callback
# Post-Logout:   http://localhost:3000/authentication/login
# Ohne Keycloak gilt der lokale DB-Admin-User.
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=webcaptioner
# KEYCLOAK_CLIENT_ID=webcaptioner-backend
# KEYCLOAK_CLIENT_SECRET=your-backend-client-secret
# KEYCLOAK_REQUIRED_GROUP=webcaptioner
# Optional, kommagetrennt. Leer = jeder Pfad /authentication/callback ist erlaubt.
# KEYCLOAK_REDIRECT_URIS=http://localhost:3000/authentication/callback